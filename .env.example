# Copy to .env and adjust. Load it before running:
#   set -a; source .env; set +a; go run ./cmd/server

# Port the HTTP server listens on.
PORT=8080

# Public address used to build short_url (no trailing slash needed).
BASE_URL=http://localhost:8080

# Postgres connection (matches docker-compose.yml). Leave empty to keep
# links in memory, which loses them on restart.
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener?sslmode=disable

# Redis cache in front of the storage (matches docker-compose.yml). Leave
# empty to run without a cache.
REDIS_URL=redis://localhost:6379/0
